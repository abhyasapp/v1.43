function makeContentFilesPrivate() {
  let changed = 0, already = 0, failed = 0;
  const makePrivate = (file) => {
    try {
      if (file.getSharingAccess() === DriveApp.Access.PRIVATE) { already++; return; }
      file.setSharing(DriveApp.Access.PRIVATE, DriveApp.Permission.NONE);
      changed++;
    } catch (e) { failed++; console.error(file.getId() + ': ' + e); }
  };
  CONTENT_FILE_IDS.forEach(id => {
    try { makePrivate(DriveApp.getFileById(id)); }
    catch (e) { failed++; console.error(id + ': ' + e); }
  });
  ['WeeklySets', 'SubjectiveQuestions', 'StudyDocs'].forEach(name => {
    const it = DriveApp.getFoldersByName(name);
    while (it.hasNext()) {
      const files = it.next().getFiles();
      while (files.hasNext()) makePrivate(files.next());
    }
  });
  const msg = 'Made private: ' + changed + ', already private: ' + already + ', failed: ' + failed;
  Logger.log(msg);
  return msg;
}
